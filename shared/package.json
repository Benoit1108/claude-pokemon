{
  "name": "claude-pokemon-shared",
  "version": "0.1.0",
  "description": "Shared battle engine + types + moves catalog for the claude-pokemon ecosystem (CLI, Worker API, arena web).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./battle": {
      "types": "./dist/battle.d.ts",
      "import": "./dist/battle.js"
    },
    "./moves": {
      "types": "./dist/moves.d.ts",
      "import": "./dist/moves.js"
    },
    "./stages": {
      "types": "./dist/stages.d.ts",
      "import": "./dist/stages.js"
    },
    "./xp": {
      "types": "./dist/xp.d.ts",
      "import": "./dist/xp.js"
    },
    "./species": {
      "types": "./dist/species.d.ts",
      "import": "./dist/species.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./state-types": {
      "types": "./dist/state-types.d.ts",
      "import": "./dist/state-types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:species": "node scripts/build-species-combat-type.mjs",
    "build:learnsets": "node scripts/build-learnsets.mjs",
    "build:gen": "npm run build:species && npm run build:learnsets",
    "fetch:pokeapi": "node scripts/fetch-pokeapi-snapshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "pokemon",
    "battle",
    "deterministic",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Benoit Bruneau",
  "homepage": "https://github.com/Benoit1108/claude-pokemon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benoit1108/claude-pokemon.git",
    "directory": "shared"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.27.3",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}

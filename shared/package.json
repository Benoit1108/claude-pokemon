{
  "name": "claude-pokemon-shared",
  "version": "0.1.0",
  "description": "Shared battle engine + types + moves catalog for the claude-pokemon ecosystem (CLI, Worker API, arena web).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./battle": {
      "types": "./dist/battle.d.ts",
      "import": "./dist/battle.js"
    },
    "./moves": {
      "types": "./dist/moves.d.ts",
      "import": "./dist/moves.js"
    },
    "./stages": {
      "types": "./dist/stages.d.ts",
      "import": "./dist/stages.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["pokemon", "battle", "deterministic", "claude-code"],
  "license": "MIT",
  "author": "Benoit Bruneau",
  "homepage": "https://github.com/Benoit1108/claude-pokemon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benoit1108/claude-pokemon.git",
    "directory": "shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}

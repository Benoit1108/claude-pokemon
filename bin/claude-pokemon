#!/usr/bin/env node
/**
 * claude-pokemon — CLI entry point.
 * Delegates to the Node-native bin/*.mjs commands. The runtime is bash-free
 * (engine/statusline/pokemon bundles + Node installers), so Windows is
 * supported natively — no WSL, no bash/chafa/flock.
 */
const { spawnSync } = require('node:child_process');
const path = require('node:path');
const fs = require('node:fs');

const ROOT = path.join(__dirname, '..');
const cmd = process.argv[2] || 'install';

const valid = ['install', 'update', 'uninstall', 'status', 'export', 'import', 'help'];

if (cmd === 'help' || cmd === '--help' || cmd === '-h') {
  console.log(`
claude-pokemon — Pokémon companion for Claude Code

Usage:
  npx claude-pokemon <command>

Commands:
  install      Set up companion in ~/.claude/pokemon/ (copies the Node runtime
               + pre-rendered sprites, patches settings.json, installs the skill).
  update       Refresh the runtime + sprites and migrate data.json if needed
               (preserves state.json — your buddy lives on).
  uninstall    Remove ~/.claude/pokemon/, the skill, and the statusLine entry
               from settings.json. Backups created.
  status       Diagnostic: prereqs OK? files in place? state coherent?
  export <f>   Save state.json to a file (backup).
  import <f>   Load state.json from a file (restore).
  help         This message.

Once installed, in Claude Code:
  /pokemon              Vue principale du compagnon
  /pokemon team         Équipe (max 6)
  /pokemon pokedex      Pokédex Gen 1 (151)
  /pokemon switch <n>   Changer de compagnon actif
  /pokemon hatch        Faire éclore un nouvel œuf
  /pokemon trade        Échange (1/jour)
  /pokemon stats        Statistiques de vie
  ...

Project: https://github.com/Benoit1108/claude-pokemon
`);
  process.exit(0);
}

if (!valid.includes(cmd)) {
  console.error(`Unknown command: ${cmd}`);
  console.error(`Run 'npx claude-pokemon help' for usage.`);
  process.exit(1);
}

// Run the Node-native command (the runtime is bash-free since Phase R3d-6).
const mjs = path.join(ROOT, 'bin', `${cmd}.mjs`);
if (!fs.existsSync(mjs)) {
  console.error(`Script not found: ${cmd}.mjs`);
  process.exit(1);
}
const args = process.argv.slice(3);
const result = spawnSync(process.execPath, [mjs, ...args], {
  stdio: 'inherit',
  env: { ...process.env, CLAUDE_POKEMON_ROOT: ROOT },
});
if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}
// status is null when the child was killed by a signal — treat as failure.
process.exit(result.status ?? 1);

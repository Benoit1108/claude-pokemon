node_modules/
*.log
.DS_Store

# Wrangler local dev secrets (e.g. api/.dev.vars holds GITHUB_CLIENT_SECRET).
# NEVER commit — only .dev.vars.example is tracked.
.dev.vars
**/.dev.vars

# User-specific testing artifacts
*.bak-*
.lock
state.json
sprites/
sprites-mini/
sprites-mini-anim/
# …except the pre-rendered sprites shipped in the package (Phase R3d-5).
!/lib/sprites/
!/lib/sprites/**
!/lib/sprites-mini/
!/lib/sprites-mini/**
.npmrc

# Demo recording intermediates (the final GIF lives in assets/)
.demo/*.cast
.demo/*-raw.gif

# Claude Code per-machine local settings (the shared settings.json + hooks
# scripts ARE committed — they define team conventions, not user prefs).
.claude/settings.local.json
.claude/scheduled_tasks.lock

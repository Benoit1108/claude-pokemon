# Template for api/.dev.vars (gitignored). Copy then fill with your DEV OAuth
# app values — NEVER put real secrets in this .example file (it's committed).
#
#   cp api/.dev.vars.example api/.dev.vars   # then edit .dev.vars
#
# Use a SEPARATE "dev" GitHub OAuth App (callback http://localhost:3000/...), so
# its client_id OVERRIDES the prod one from wrangler.toml for local `wrangler dev`.

GITHUB_CLIENT_ID=your-dev-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-dev-oauth-app-client-secret

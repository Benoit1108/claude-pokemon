{
  "name": "claude-pokemon-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for claude-pokemon shared anonymous stats",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed:local": "bash scripts/seed-local.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.{ts,json}' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,json}' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "claude-pokemon-shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}

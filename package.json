{
  "name": "claude-pokemon",
  "version": "1.0.0-beta.7",
  "description": "A persistent Pokémon companion for Claude Code's statusLine. Hatch eggs, evolve, switch teams, catch wild Pokémon — all while you code.",
  "keywords": [
    "claude-code",
    "claude",
    "statusline",
    "pokemon",
    "companion",
    "gamification",
    "cli"
  ],
  "author": "Benoit Bruneau",
  "license": "MIT",
  "homepage": "https://github.com/Benoit1108/claude-pokemon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benoit1108/claude-pokemon.git"
  },
  "bugs": {
    "url": "https://github.com/Benoit1108/claude-pokemon/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-pokemon": "./bin/claude-pokemon"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run -w api dev\" \"npm run -w web dev\"",
    "build:data": "bash scripts/build-data.sh && npm run -s -w shared build:gen && npm run -s -w shared build && npm run -s -w cli build:engine",
    "test": "bats tests/cli/",
    "ci:pre-push": "bash scripts/ci-pre-push.sh"
  },
  "files": [
    "bin/",
    "lib/pokemon.mjs",
    "lib/statusline.mjs",
    "lib/data.default.json",
    "lib/locales/",
    "lib/sprites/",
    "lib/sprites-mini/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "api",
    "shared",
    "cli",
    "web"
  ],
  "devDependencies": {
    "bats": "^1.13.0",
    "concurrently": "^10.0.3"
  }
}
